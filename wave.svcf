# SimVision Command Script (Thu Nov 12 20:33:23 -03 2026)
#
# Version 24.09.s001
#
# You can restore this configuration with:
#
#     simvision -input /home/aluno/Documents/neander/wave.svcf
#


#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set waveform-print-paper {A4 (210mm x 297mm)}
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set waveform-print-colors {Color on white}
#
# Groups
#
catch {group new -name Mem -overlay 0}
catch {group new -name RDM -overlay 0}
catch {group new -name PC -overlay 0}
catch {group new -name {Group 4} -overlay 0}
catch {group new -name {Group 5} -overlay 0}
catch {group new -name MUX -overlay 0}
catch {group new -name REM -overlay 0}
group using Mem
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {tb_datapaph.write}]} ] \
    [subst  {[format {tb_datapaph.read}]} ] \
    [subst  {[format {tb_datapaph.data_out[7:0]}]} ]
group using RDM
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {tb_datapaph.carga_rdm}]} ] \
    [subst  {[format {tb_datapaph.in_rdm[7:0]}]} ] \
    [subst  {[format {tb_datapaph.sel_rdm}]} ] \
    [subst  {[format {tb_datapaph.out_mux_rdm[7:0]}]} ] \
    [subst  {[format {tb_datapaph.out_rdm[7:0]}]} ]
group using PC
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {tb_datapaph.inc}]} ] \
    [subst  {[format {tb_datapaph.carga_pc}]} ] \
    [subst  {[format {tb_datapaph.out_pc[7:0]}]} ]
group using {Group 4}
group set -overlay 0
group set -comment {}
group clear 0 end

group using {Group 5}
group set -overlay 0
group set -comment {}
group clear 0 end

group using MUX
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {tb_datapaph.out_mux[7:0]}]} ] \
    [subst  {[format {tb_datapaph.sel_mux}]} ]
group using REM
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {[format {tb_datapaph.carga_rem}]} ] \
    [subst  {[format {tb_datapaph.out_rem[7:0]}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+261+33}] != ""} {
    window geometry "Design Browser 1" 730x500+261+33
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {[format {tb_datapaph}]} ]
browser set \
    -signalsort name
browser yview see [subst  {[format {tb_datapaph}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 978x712+1175+507}] != ""} {
    window geometry "Waveform 1" 978x712+1175+507
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals [subst  {
	{[format {tb_datapaph.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb_datapaph.rst}]}
	} ]]

set groupId0 [waveform add -groups MUX]


set groupId0 [waveform add -groups Mem]


set groupId0 [waveform add -groups RDM]


set groupId0 [waveform add -groups PC]


set groupId0 [waveform add -groups REM]


waveform xview limits 53ns 90ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+261+564

#
# Layout selection
#

