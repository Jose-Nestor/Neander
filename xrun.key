probe -create -shm tb_sub_matrizes.carga_pc tb_sub_matrizes.carga_ri tb_sub_matrizes.clk tb_sub_matrizes.dado_prog tb_sub_matrizes.escritas tb_sub_matrizes.esperado tb_sub_matrizes.imagem tb_sub_matrizes.instrucao_nao_implementada tb_sub_matrizes.instrucao_pronta tb_sub_matrizes.negativo_out tb_sub_matrizes.out_ac tb_sub_matrizes.out_pc tb_sub_matrizes.out_rdm tb_sub_matrizes.out_rem tb_sub_matrizes.out_ri tb_sub_matrizes.parado tb_sub_matrizes.prog_carga_rdm tb_sub_matrizes.prog_carga_rem tb_sub_matrizes.prog_write tb_sub_matrizes.programando tb_sub_matrizes.rst tb_sub_matrizes.write tb_sub_matrizes.zero_out
